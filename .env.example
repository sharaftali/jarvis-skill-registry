# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skill_registry

# Security
SECRET_KEY=replace-with-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=Jarvis Skill Registry
APP_VERSION=1.0.0
DEBUG=True

# Organizations
ORGANIZATIONS=default-org,ABC Construction,XYZ Builders
DEFAULT_ORGANIZATION_ID=default-org
DEFAULT_ORGANIZATION_NAME=Default Organization

# Default bootstrap admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@local.dev
DEFAULT_ADMIN_PASSWORD=change-me-before-production
